# Rust build artifacts
/target/
**/target/

# Pre-built example binaries (only the .rs sources are committed)
/examples/examples_win32/
/examples/examples_linux/
/examples/examples_macos/
/examples/minitest_win32/
/examples/minitest_macos/
/dist/
/release/*
!/release/README.md

# Build / smoke / test logs and stderr captures
*.log
*.txt
!src/**/*.txt
!assets/**/*.txt
!tests/**/*.txt
*.err
/_ttsize.exe
/_ttsize.pdb

# Repro / smoke build outputs (the .rs source is committed, not the .exe)
/repro_*.exe
/examples/repro_*.exe
/examples/*/repro_*.exe

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor cruft
.vscode/
.idea/
*.swp
*.swo
*~

# Cargo / rust-analyzer caches
.cargo/
rust-project.json
